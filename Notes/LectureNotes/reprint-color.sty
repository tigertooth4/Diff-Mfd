\newcommand{\examplesname}{Examples}
\newcommand{\remarksname}{Remarks}
\makeatletter
\ELEGANT@newtheorem{examples}{ex}{prostyle}
\ELEGANT@newtheorem{remarks}{rem}{prostyle}
\newcommand{\warnernumber}[1]{\setcounter{ELEGANT@samecnt}{\numexpr#1-1\relax}}
\newcommand{\discuss}[2]{\par\addvspace{9pt}\Needspace{4\baselineskip}\refstepcounter{ELEGANT@samecnt}\noindent\textbf{\color{structurecolor}\theELEGANT@samecnt\if\relax\detokenize{#2}\relax\else\quad #2\fi}\quad\ignorespaces}
\newcommand{\citem}[1]{\item[#1]\def\@currentlabel{#1}}
% Keep the original inline example/remark treatment in the appendices, but
% synchronize their counters with the revised appendix references.
\renewenvironment{example}[1][]{\par\medskip\refstepcounter{ELEGANT@samecnt}\noindent\textbf{\color{main}\examplename~\theELEGANT@samecnt\ifstrempty{#1}{}{\ (#1)}}\enspace\normalfont}{\par\smallskip}
\renewenvironment{remark}[1][]{\par\medskip\refstepcounter{ELEGANT@samecnt}\noindent\textbf{\color{second}\remarkname~\theELEGANT@samecnt\ifstrempty{#1}{}{\ (#1)}}\enspace\normalfont}{\par\smallskip}
% A caption within a boxed statement must be inline, not a floating object.
\newenvironment{elegantinlinefigure}[1][]{\par\medskip\noindent\begin{minipage}{\linewidth}\def\@captype{figure}}{\end{minipage}\par\medskip}
\newcommand{\elegantlocalfigures}{\let\figure\elegantinlinefigure\let\endfigure\endelegantinlinefigure}
\makeatother
\renewenvironment{problemset}[1][]{\begin{enumerate}[#1]}{\end{enumerate}}
\RenewDocumentEnvironment{proof}{O{\proofname}}{\par\medskip\noindent\textbf{\color{second}#1}\enspace\normalfont\ignorespaces}{\par\smallskip}
\providecommand{\qedhere}{}
% Local adjustments only: wrap long title tabs, keep definitions upright,
% and avoid splitting off fewer than four lines at a page boundary.
\tcbset{common/.append style={varwidth boxed title*=-10mm,
 boxed title style={before upper=\raggedright},lines before break=4,
 before upper={\elegantlocalfigures}},defstyle/.append style={fontupper=\normalfont}}
\renewcommand{\sectionmark}[1]{\markright{#1}}
\newcommand{\RR}{\mathbb R}
\newcommand{\cl}{\operatorname{cl}}
\newcommand{\ac}{\operatorname{ac}}
\DeclareMathOperator{\Hom}{Hom}
\renewcommand{\circled}[1]{\text{\tikz[baseline=(n.base)]\node[draw,circle,inner sep=1pt,font=\scriptsize](n){#1};}}
\newcommand{\redrawn}[1]{\input{figures/redrawn/#1.tex}}
