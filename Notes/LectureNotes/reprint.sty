% Retain both historical {title} and standard [title] source syntax.
\newcommand{\DeclareReprintTheorem}[3]{%
 \theoremstyle{#3}%
 \newtheorem{rp#1}[warner]{#2}%
 \newtheorem*{rp#1star}{#2}%
 \NewDocumentEnvironment{#1}{g o}{\IfNoValueTF{##1}{\IfNoValueTF{##2}{\begin{rp#1}}{\begin{rp#1}[{##2}]}}{\begin{rp#1}[{##1}]}}{\end{rp#1}}%
 \NewDocumentEnvironment{#1*}{g o}{\IfNoValueTF{##1}{\IfNoValueTF{##2}{\begin{rp#1star}}{\begin{rp#1star}[{##2}]}}{\begin{rp#1star}[{##1}]}}{\end{rp#1star}}}
\DeclareReprintTheorem{definition}{Definition}{reprintdefinition}
\DeclareReprintTheorem{theorem}{Theorem}{reprintplain}
\DeclareReprintTheorem{lemma}{Lemma}{reprintplain}
\DeclareReprintTheorem{proposition}{Proposition}{reprintplain}
\DeclareReprintTheorem{corollary}{Corollary}{reprintplain}
\DeclareReprintTheorem{examples}{Examples}{reprintdefinition}
\DeclareReprintTheorem{remarks}{Remarks}{reprintdefinition}
\DeclareReprintTheorem{example}{Example}{reprintdefinition}
\DeclareReprintTheorem{remark}{Remark}{reprintdefinition}
